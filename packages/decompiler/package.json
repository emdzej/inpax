{
  "name": "@emdzej/inpax-decompiler",
  "version": "0.12.0",
  "description": "INPA IPO bytecode decompiler — lifts compiled .IPO files back to readable .IPS-like source. Recognises function calls, assignments, expressions, structured if/else and while loops; falls back to goto+label for irreducible flow.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist/"
  },
  "keywords": [
    "inpa",
    "ipo",
    "decompiler",
    "bmw"
  ],
  "license": "MIT",
  "dependencies": {
    "@emdzej/inpax-core": "workspace:*"
  },
  "devDependencies": {
    "@emdzej/inpax-parser": "workspace:*",
    "@types/node": "^22.13.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/emdzej/inpax.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
